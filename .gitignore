.DS_Store
/.build
/Packages
/*.xcodeproj
xcuserdata/
DerivedData/
.swiftpm/config/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc
.swiftpm
.dependencies
.derivedData
*.tmp
session-state-*.json

# Versioned-ViewModel test baselines are regenerable test fixtures (no shipped
# wire-format contract), so they are not committed. Intentional serialization
# canaries are tracked explicitly via the negation below.
Tests/**/.VersionedTestJSON/*
!Tests/**/.VersionedTestJSON/TestVersionedViewModel_*.json
.worktrees/

# Cross-repo dialogue files authored with/for client sessions — never committed here;
# the client repo is their home (see each file's wall reminder).
docs/work/client/

# Generated by xcodegen for the UI-testing probe (see Tools/UITestingProbe/README.md)
Tools/UITestingProbe/*.xcodeproj
Tools/UITestingProbe/*.log

# Plan references customer verification targets — kept local, never committed
planning/implementation-plans/fosmvvm-review-check-coverage.md

import FOSFoundation
import FOSMVVM
import Foundation

/// One card on the board. `title` is data (from the server's Fluent record), not a
/// localized UI string.
///
/// `ownerTag` is the correlation-seam key: the client-hosted `AboutViewModel` carries
/// the same tag (`localOwnerTag`), and the *view* joins them to mark "my" cards — the
/// server VM exposes the key, the view joins, and no single VM ever serves both doors.
@ViewModel
public struct CardViewModel {
    public let title: String
    public let ownerTag: String?

    /// Derived from the record's data identity, so equal data means stable SwiftUI
    /// identity — a re-fetch must not re-identify unchanged rows.
    public let vmId: ViewModelId

    public init(id: ModelIdType, title: String, ownerTag: String?) {
        self.vmId = .init(id: id)
        self.title = title
        self.ownerTag = ownerTag
    }
}

public extension CardViewModel {
    static func stub() -> Self {
        .init(
            id: .init(uuidString: "00000000-0000-0000-0000-000000000042")!,
            title: "Fred's Bedrock Card",
            ownerTag: nil
        )
    }
}

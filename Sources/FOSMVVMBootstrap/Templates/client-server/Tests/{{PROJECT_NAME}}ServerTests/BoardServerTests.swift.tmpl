import Fluent
import FOSFoundation
import FOSMVVM
import FOSTesting
import FOSTestingVapor
import Foundation
import Testing
import Vapor
@testable import {{PROJECT_NAME}}Server
import {{PROJECT_NAME}}ViewModels

/// Boots the real server pipeline headlessly on SQLite-in-memory and drives both
/// requests through the typed test door — the same derivation `processRequest`
/// uses in production (URL, verb, headers, and the SystemVersion handshake all
/// come from the request, never hand-built).
@Suite("BoardServer", .serialized)
struct BoardServerTests {
    /// The board read: the screen's primary fetch serves the seeded board.
    @Test func boardRequestServesTheBoard() async throws {
        try await withFluentTestApp { app in
            try registerServices(app)
        } _: { app, db in
            let board = Board(name: "Test Board")
            try await board.save(on: db)

            try await app.testing().test(BoardRequest()) { response in
                #expect(response.status == .ok)
                let served = try #require(response.body)
                #expect(served.cards.isEmpty)
            }
        }
    }

    /// The live+write loop: a create through the typed door commits, and the
    /// re-served `BoardViewModel` reflects the new card.
    @Test func createCardRefreshesTheLiveBoard() async throws {
        try await withFluentTestApp { app in
            // The harness owns the DB + autoMigrate + boot; we register the same
            // services the generated configure does.
            try registerServices(app)
        } _: { app, db in
            // The harness path doesn't run the demo seed — seed one board.
            let board = Board(name: "Test Board")
            try await board.save(on: db)
            let before = try await Card.query(on: db).count()

            let create = CardCreateRequest(
                query: nil, sort: nil, fragment: nil,
                requestBody: CardCreateBody(title: "New Card"), responseBody: nil
            )

            try await app.testing().test(create) { response in
                #expect(response.status == .ok)
                let refreshed = try #require(response.body)
                #expect(refreshed.cards.count == before + 1)
                #expect(refreshed.cards.contains { $0.title == "New Card" })
            }
        }
    }

    /// The Fields contract gates the write: an empty title is rejected before
    /// anything commits. Paired with the success test above, this proves the
    /// validator runs on the server — not merely that it compiles into it.
    @Test func createCardRejectsAnEmptyTitle() async throws {
        try await withFluentTestApp { app in
            try registerServices(app)
        } _: { app, db in
            let board = Board(name: "Test Board")
            try await board.save(on: db)
            let before = try await Card.query(on: db).count()

            let create = CardCreateRequest(
                query: nil, sort: nil, fragment: nil,
                requestBody: CardCreateBody(title: ""), responseBody: nil
            )

            try await app.testing().test(create) { response in
                #expect(response.status == .badRequest)
                #expect(response.body == nil)
            }

            let after = try await Card.query(on: db).count()
            #expect(after == before)
        }
    }
}
